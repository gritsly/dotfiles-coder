#!/usr/bin/env bash
set -euo pipefail

if [ -z "${USER:-}" ]; then
    USER=$(id -un)
fi

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
DOTFILES_DIR="$SCRIPT_DIR/dotfiles.codespaces"
LOCAL_BIN="$HOME/.local/bin"
CODEX_CONFIG_DIR="${CODEX_HOME:-$HOME/.codex}"
CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

export PATH="$LOCAL_BIN:$PATH"

echo >&2 "====================================================================="
echo >&2 " Setting up coder environment"
echo >&2 ""
echo >&2 " USER        $USER"
echo >&2 " HOME        $HOME"
echo >&2 "====================================================================="

initialize_orca_workspace_instance() {
    if [ ! -f /tmp/orca-instance-initialized ]; then
        rm -f /workspaces/.orca/orcad.lock
        touch /tmp/orca-instance-initialized
    fi
}

install_agent_instructions() {
    local instructions="$DOTFILES_DIR/AGENTS.md"

    mkdir -p "$CLAUDE_CONFIG_DIR" "$CODEX_CONFIG_DIR"
    install -m 0644 "$instructions" "$CLAUDE_CONFIG_DIR/CLAUDE.md"
    install -m 0644 "$instructions" "$CODEX_CONFIG_DIR/AGENTS.override.md"
}

setup_local_bin() {
    mkdir -p "$LOCAL_BIN"
}

install_git_identity() {
    local email="${DOTFILES_GIT_EMAIL:-}"

    git config --global user.name gritsly
    # Fall back to the email of the Claude Code login, which lives outside this public repository.
    if [ -z "$email" ] && [ -r "$CLAUDE_CONFIG_DIR/.claude.json" ]; then
        email=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["oauthAccount"]["emailAddress"])' \
            "$CLAUDE_CONFIG_DIR/.claude.json" 2>/dev/null || true)
    fi
    if [ -n "$email" ]; then
        git config --global user.email "$email"
    else
        echo >&2 "git user.email not set: export DOTFILES_GIT_EMAIL or log in to Claude Code, then rerun setup"
    fi
}

install_hal_skill() {
    local skill_dir="$CLAUDE_CONFIG_DIR/skills/hal"

    mkdir -p "$CLAUDE_CONFIG_DIR/skills"
    rm -rf "$skill_dir"
    cp -R "$DOTFILES_DIR/skills/hal" "$skill_dir"
    chmod 0755 "$skill_dir/scripts/hal.py"
}

install_zsh_user_config() {
    local source_line='[ -r "$HOME/.zshrc.user" ] && source "$HOME/.zshrc.user"'
    local zshrc="$HOME/.zshrc"
    local tmp

    install -m 0644 "$DOTFILES_DIR/.zshrc.user" "$HOME/.zshrc.user"

    if [ ! -f "$zshrc" ]; then
        printf '%s\n' "$source_line" > "$zshrc"
        return
    fi

    tmp=$(mktemp)
    awk -v source_line="$source_line" '
        $0 == source_line {
            next
        }
        $0 == "[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh" {
            next
        }
        $0 ~ /^source[[:space:]]+\$ZSH\/oh-my-zsh\.sh$/ {
            print
            if (!inserted) {
                print source_line
                inserted = 1
            }
            next
        }
        { print }
        END {
            if (!inserted) {
                print source_line
            }
        }
    ' "$zshrc" > "$tmp"
    cat "$tmp" > "$zshrc"
    rm "$tmp"
}

install_ssh_config() {
    local legacy_user_config="$HOME/.ssh/config.user"

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    install -m 0600 "$DOTFILES_DIR/.ssh/ssh_config.user" "$HOME/.ssh/ssh_config.user"

    # Remove the old managed path after moving to the devcontainer's user include.
    if [ -f "$legacy_user_config" ] && cmp -s "$legacy_user_config" "$HOME/.ssh/ssh_config.user"; then
        rm "$legacy_user_config"
        if [ -f "$HOME/.ssh/config" ]; then
            sed -i '\|^Include ~/.ssh/config.user$|d' "$HOME/.ssh/config"
        fi
    fi
}

initialize_orca_workspace_instance
install_agent_instructions
setup_local_bin
install_git_identity
install_hal_skill
install_zsh_user_config
install_ssh_config
